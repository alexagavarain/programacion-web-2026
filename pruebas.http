@host = http://localhost:8000

### Listar todas las materias
GET {{host}}/api/subjects.php

### Listar todas las tareas
GET {{host}}/api/tasks.php

### Obtener una tarea por ID
GET {{host}}/api/tasks.php?id=2

### Crear una tarea válida (espera 201)
POST {{host}}/api/tasks.php
Content-Type: application/json

{
  "title": "Práctica con REST Client",
  "description": "Probando endpoint desde VS Code",
  "subjectId": 2,
  "dueDate": "2026-12-31"
}

### Crear tarea con fecha pasada o datos inválidos (espera 422)
POST {{host}}/api/tasks.php
Content-Type: application/json

{
  "title": "sjaks",
  "subjectId": 1,
  "dueDate": "2020-01-01"
}

###############################################################
# TAREAS: ACTUALIZAR (UPDATE)
###############################################################

### Actualizar tarea completa o cambiar estado (espera 200)
PUT {{host}}/api/tasks.php?id=2
Content-Type: application/json

{
  "title": "Tarea actualizada desde REST Client",
  "description": "Nueva descripción",
  "subjectId": 2,
  "dueDate": "2026-12-31",
  "dueTime": "12:23",
  "status": "COMPLETADA"
}

### Actualizar con fecha anterior a hoy (espera 422 por tu trigger de BD)
PUT {{host}}/api/tasks.php?id=1
Content-Type: application/json

{
  "title": "Tarea con fecha inválida",
  "description": "Probando trigger BEFORE UPDATE",
  "subjectId": 2,
  "dueDate": "2020-01-01",
  "status": "PENDIENTE"
}

### Actualizar un id que no existe (espera 404)
PUT {{host}}/api/tasks.php?id=999
Content-Type: application/json

{
  "title": "Tarea fantasma",
  "subjectId": 1,
  "dueDate": "2026-12-31"
}

###############################################################
# TAREAS: ELIMINAR (DELETE)
###############################################################

### Eliminar una tarea existente (espera 204 o 200)
DELETE {{host}}/api/tasks.php?id=2

### Eliminar una tarea que no existe (espera 404)
DELETE {{host}}/api/tasks.php?id=999